# Build artifacts
build/
# Local native-library build outputs (downloaded at build time via hooks, never
# bundled). Anchored: an unanchored `bin/` would also strip example_cli/bin/,
# publishing the CLI example without its only source file.
/bin/
# The package ships no podspec / plugin scaffolding; the top-level ios/ and macos/
# dirs hold only local build outputs (Libraries/) and stale Xcode artifacts, none
# of which belong in the published package (native delivery is via hook/build.dart).
# Anchored with a leading slash so example/ios and example/macos are unaffected.
/ios/
/macos/
example/build/
example/.dart_tool/
example/.flutter-plugins
example/.flutter-plugins-dependencies
example/ios/Podfile.lock
example/macos/Podfile.lock
example/.idea/
example/android/.gradle/
example/ios/Pods/

# FVM
.fvm/

# Generated documentation
doc/
